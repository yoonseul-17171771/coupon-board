<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#f8f6ff">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="학습관리노트">
<meta name="application-name" content="학습관리노트">
<title>💜 학습관리노트</title>
<style>
  /* ============ 기본 ============ */
  :root{
    --pink:#8b74d4; --pink-deep:#6e56b8; --pink-soft:#efe8fd;
    --lilac:#7f6bc9; --lilac-soft:#e8e6ff;
    --blue:#5b76c9; --blue-soft:#e6ebff;
    --green:#4f9a72; --green-soft:#e2f4e8;
    --amber:#b8862f; --amber-soft:#fff0d8;
    --ink:#4c4463; --ink-soft:#6f6787; --muted:#9a91ae;
    --line:#ebe4f7; --line-strong:#d9cbf2;
    --card:#fffefe;
    --shadow:0 8px 26px rgba(142,126,196,.10), 0 1px 0 rgba(255,255,255,.9) inset;
    --r:22px;
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%}
  body{
    margin:0; padding:0; color:var(--ink);
    font-family:"Apple SD Gothic Neo","Pretendard","Noto Sans KR","Noto Sans CJK KR","Malgun Gothic","맑은 고딕",system-ui,-apple-system,"Segoe UI",
      "Apple Color Emoji","Noto Color Emoji","Segoe UI Emoji",sans-serif;
    font-size:15px; line-height:1.5; letter-spacing:-0.01em;
    background:
      radial-gradient(900px 620px at 8% -8%, #efe8fd 0%, rgba(239,232,253,0) 62%),
      radial-gradient(820px 560px at 96% -4%, #e8ecff 0%, rgba(232,236,255,0) 58%),
      radial-gradient(760px 620px at 50% 108%, #e9edff 0%, rgba(233,237,255,0) 60%),
      linear-gradient(180deg,#fbfaff 0%, #f7f3ff 46%, #f8f6ff 100%);
    background-attachment:fixed;
    min-height:100vh;
    -webkit-tap-highlight-color:transparent;
  }
  button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
  input,textarea{font:inherit;color:inherit}
  h1,h2,h3,p{margin:0}
  .wrap{max-width:1080px;margin:0 auto;padding:18px 14px 46px}

  /* ============ 헤더 ============ */
  .top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin:4px 2px 14px}
  .brand h1{font-size:clamp(19px,4.6vw,25px);font-weight:800;letter-spacing:-0.03em;color:#453a5c}
  .brand .sub{font-size:12px;color:var(--muted);margin-top:3px;font-weight:600}
  .top-actions{display:flex;align-items:center;gap:8px;flex-shrink:0}
  .sync-chip{
    font-size:11px;font-weight:700;color:#9a90ae;background:#fffefe;border:1px solid var(--line);
    border-radius:99px;padding:6px 10px;white-space:nowrap;box-shadow:0 2px 8px rgba(142,126,196,.08)
  }
  .sync-chip.ok{color:#4f9a72;border-color:#cfe9da;background:#f6fdf9}
  .sync-chip.saving{color:#7f6bc9;border-color:#ddd2f8;background:#f7f3ff}
  .sync-chip.error{color:#c9603f;border-color:#f6d6c9;background:#fff8f4}
  .icon-btn{
    width:38px;height:38px;border-radius:50%;background:#fffefe;border:1px solid var(--line);
    display:grid;place-items:center;font-size:17px;box-shadow:0 3px 12px rgba(142,126,196,.12)
  }
  .icon-btn.small{width:30px;height:30px;font-size:14px;box-shadow:none}
  .icon-btn:active{transform:scale(.95)}

  /* ============ 탭 ============ */
  .tabs{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
  .tab{
    display:flex;align-items:center;justify-content:center;gap:6px;
    padding:12px 8px;border-radius:18px;background:#fffefe;border:1px solid var(--line);
    font-weight:800;font-size:14px;color:#9a90ae;transition:all .18s;box-shadow:0 2px 10px rgba(142,126,196,.06)
  }
  .tab .tem{font-size:16px}
  .tab.on{
    color:var(--pink-deep);background:linear-gradient(135deg,#ece3fd,#f6f0ff);
    border-color:var(--line-strong);box-shadow:0 6px 18px rgba(150,130,220,.20), 0 1px 0 #fff inset
  }

  /* ============ 카드 ============ */
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:14px 14px 16px;margin-bottom:14px}
  .card-title{font-size:15px;font-weight:800;letter-spacing:-0.02em;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px}
  .card-sub{font-size:11.5px;font-weight:700;color:var(--muted);background:#f3edfd;border:1px solid var(--line);padding:3px 9px;border-radius:99px}
  .hint{font-size:11px;color:#a99fbc;line-height:1.55;margin-top:10px}
  .layout{display:grid;grid-template-columns:minmax(0,1fr);gap:14px}
  @media(min-width:980px){
    /* 2단: 왼쪽(달력+통계)과 오른쪽(입력 패널)의 하단 끝라인을 항상 같게 맞춥니다.
       align-items:stretch 로 두 열이 같은 높이까지 늘어나고,
       남는 높이는 달력 칸·통계 막대·입력 패널이 나눠서 흡수해요.
       (칩 유무, 통계 항목 길이가 달라져도 하단은 0px 로 맞습니다) */
    .layout{
      grid-template-columns:minmax(0,1fr) minmax(0,1fr);
      grid-template-areas:"cal day" "stats day" "cmp cmp" "rev rev";
      align-items:stretch;
      align-content:start
    }
    .layout > .card{margin-bottom:0}
    .cal-card{grid-area:cal}
    .day-card{grid-area:day}
    .stats-card{grid-area:stats}
    .cmp-card{grid-area:cmp}
    .rev-card{grid-area:rev}
    .cal-card,.day-card,.stats-card{display:flex;flex-direction:column;min-height:0}
    .cal-card .grid{flex:1 1 auto;grid-auto-rows:minmax(74px,1fr)}
    .cal-card .day{min-height:74px;gap:4px;justify-content:center}
    .cal-card .day .num{font-size:13px}
    .stats-card .bars{flex:1 1 auto;align-content:space-between}
    .day-card #dayFields{flex:1 1 auto;display:flex;flex-direction:column;min-height:0}
    .day-card .field{flex:1 1 auto;display:flex;flex-direction:column;justify-content:space-between}
    .day-card .field .fbtns{margin-top:auto}
    .day-card .sums{margin-top:auto}
  }

  /* ============ 달력 ============ */
  .cal-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
  .cal-title{display:flex;flex-direction:column;align-items:center;gap:4px;flex:1}
  .cal-title strong{font-size:16px;font-weight:800;letter-spacing:-0.02em}
  .today-btn{
    font-size:11px;font-weight:700;color:var(--pink-deep);background:#f3edfd;
    border:1px solid #ded1f6;border-radius:99px;padding:2px 10px
  }
  .nav-btn{
    width:34px;height:34px;border-radius:50%;background:#fffefe;border:1px solid var(--line);
    display:grid;place-items:center;font-size:13px;color:#a49ab8;flex-shrink:0
  }
  .nav-btn:active{transform:scale(.94)}
  .dow{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:5px}
  .dow span{text-align:center;font-size:11px;font-weight:800;color:#b3a9c6}
  .dow .sun{color:#c06896}
  .dow .sat{color:#7e86cc}
  .grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
  .day{
    position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;
    min-height:64px;padding:6px 3px 4px;border-radius:13px;background:#fffefe;
    border:1px solid #eee7f9;transition:background .15s,border-color .15s,box-shadow .15s
  }
  .day.blank{background:transparent;border-color:transparent;pointer-events:none;box-shadow:none}
  .day .num{font-size:12.5px;font-weight:700;color:#7c7391;line-height:1}
  .day.sun .num{color:#bd6b96}
  .day.sat .num{color:#7e86cc}
  .day.has{background:linear-gradient(180deg,#fdfbff,#f8f4ff);border-color:#e3d8f7}
  .day.today{box-shadow:inset 0 0 0 2px #b9a2ee}
  .day.today .num{color:var(--pink-deep);font-weight:800}
  .day.sel{background:linear-gradient(155deg,#e9e0fc,#f3ecff);border-color:#b49ae8;box-shadow:0 5px 16px rgba(150,130,220,.26)}
  .day .chips{display:flex;flex-direction:column;align-items:center;gap:2px;width:100%}
  .chip{
    font-style:normal;font-size:9px;line-height:1.3;font-weight:800;padding:1px 4px;border-radius:6px;
    white-space:nowrap;letter-spacing:-0.02em
  }
  .chip.p{background:var(--pink-soft);color:#6e56b8}
  .chip.g{background:var(--green-soft);color:#43845f}
  .chip.a{background:var(--amber-soft);color:#a8752a}
  .chip.k{background:var(--lilac-soft);color:#5d5a91}
  @media(max-width:420px){
    .day{min-height:57px;padding:5px 2px 3px;border-radius:11px}
    .day .num{font-size:11.5px}
    .chip{font-size:8px;padding:0 3px;border-radius:5px}
    .grid,.dow{gap:4px}
  }

  /* ============ 날짜 입력 ============ */
  .day-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:11px;flex-wrap:wrap}
  .day-head h2{font-size:16px;font-weight:800;letter-spacing:-0.02em}
  .day-meta{display:flex;align-items:center;gap:6px}
  .tag{font-size:10.5px;font-weight:800;color:#fff;background:linear-gradient(135deg,#9b83dd,#8b74d4);border-radius:99px;padding:3px 9px}
  .tag[hidden]{display:none}
  .link-btn{font-size:11px;font-weight:700;color:#a49ab8;background:#f7f4fd;border:1px solid var(--line);border-radius:99px;padding:3px 9px}
  .field{border:1px solid #ece5f8;border-radius:16px;padding:10px 11px;background:linear-gradient(180deg,#fffefe,#faf8ff);margin-bottom:8px}
  .field-top{display:flex;align-items:center;justify-content:space-between;gap:10px}
  .fname{font-weight:800;font-size:13.5px;display:flex;align-items:center;gap:6px}
  .fname .em{font-size:14px}
  .fval{display:flex;align-items:center;gap:3px;background:#fff;border:1px solid #e6ddf5;border-radius:12px;padding:2px 8px}
  .fval input.num{
    width:52px;border:0;outline:0;background:transparent;text-align:right;
    font-weight:800;font-size:16px;color:var(--pink-deep);padding:3px 0;-moz-appearance:textfield
  }
  .fval input.num::-webkit-outer-spin-button,.fval input.num::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .fval .unit{font-size:11px;font-weight:800;color:var(--muted)}
  .fbtns{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}
  .qbtn{
    border:1px solid #e2d6f6;background:linear-gradient(180deg,#f2ecfd,#efe8fd);color:#6e56b8;
    font-weight:800;font-size:11.5px;border-radius:11px;padding:8px 2px;transition:transform .1s,filter .15s
  }
  .qbtn.plus{background:linear-gradient(180deg,#e4d9fb,#d4c4f7);border-color:#c6b2f2}
  .qbtn.ghost{background:#f6f2ff;border-color:#e0d6f6;color:#7b6b9e}
  .qbtn:active{transform:scale(.955)}
  .sums{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:12px}
  .sum-pill{border-radius:14px;padding:8px 9px;border:1px solid;display:flex;flex-direction:column;gap:1px;min-width:0}
  .sum-pill span{font-size:10.5px;font-weight:800;opacity:.82;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .sum-pill strong{font-size:15px;font-weight:800;letter-spacing:-0.02em}
  .sp-pink{background:linear-gradient(180deg,#f4eeff,#f9f4ff);border-color:#ddd0f6}
  .sp-pink strong,.sp-pink span{color:#6e56b8}
  .sp-lilac{background:linear-gradient(180deg,#f7f3ff,#f2ecff);border-color:#ded2f8}
  .sp-lilac strong,.sp-lilac span{color:#5d5a91}
  .sp-green{background:linear-gradient(180deg,#f5fdf8,#e8f8ee);border-color:#d3ecde}
  .sp-green strong,.sp-green span{color:#43845f}

  /* ============ 통계 ============ */
  .tiles{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
  @media(min-width:560px){.tiles{grid-template-columns:repeat(3,minmax(0,1fr))}}
  .tile{background:linear-gradient(180deg,#fdfbff,#f8f4ff);border:1px solid var(--line);border-radius:15px;padding:9px 11px}
  .tile .k{font-size:10.5px;font-weight:800;color:var(--muted)}
  .tile .v{font-size:17px;font-weight:800;margin-top:2px;letter-spacing:-0.03em;color:#4b4163}
  .tile .v small{font-size:10.5px;font-weight:700;color:#a79dbb;margin-left:2px}
  .bars{display:grid;gap:11px;margin-top:13px}
  .bar-row{display:grid;grid-template-columns:96px minmax(0,1fr) 56px;align-items:center;gap:9px}
  .bar-row .lb{font-size:12px;font-weight:800;color:#635a7c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .bar-mid{min-width:0}
  .bar-track{display:block;height:9px;background:#eee9f9;border-radius:99px;overflow:hidden}
  .bar-track i{display:block;height:100%;border-radius:99px;background:linear-gradient(90deg,#c7b4f2,#a98ce6);transition:width .3s}
  .bar-track i.lilac{background:linear-gradient(90deg,#cfd3ff,#a6adee)}
  .bar-track i.blue{background:linear-gradient(90deg,#cdd8ff,#93abef)}
  .bar-track i.green{background:linear-gradient(90deg,#cdeed9,#a4dcbb)}
  .bar-track i.amber{background:linear-gradient(90deg,#ffe3b3,#f7cd85)}
  .bar-sub{display:block;font-size:10px;color:#a89ebb;margin-top:3px;font-weight:600}
  .bar-row .vl{font-size:11.5px;font-weight:800;color:#7c7391;text-align:right}

  /* ============ 월별 비교 ============ */
  .chart{display:flex;align-items:flex-end;gap:5px;height:112px;padding:10px 10px 4px;background:linear-gradient(180deg,#fbf9ff,#f7f4ff);border:1px solid #ece5f8;border-radius:16px;margin-bottom:12px}
  .bar-wrap{flex:1 1 0;min-width:10px;max-width:88px;height:100%;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px}
  .bar-wrap .bar{width:100%;max-width:30px;border-radius:7px 7px 3px 3px;background:linear-gradient(180deg,#c3b0f0,#a487e2);min-height:3px}
  .bar-wrap .bar.zero{background:#eee9f7}
  .bar-wrap .bl{font-size:9.5px;font-weight:700;color:#a89ebb}
  .table-wrap{overflow-x:auto;-webkit-overflow-scrolling:touch;border-radius:13px}
  @media(max-width:759px){
    .table-wrap{
      -webkit-mask-image:linear-gradient(90deg,#000 82%,rgba(0,0,0,.15) 100%);
      mask-image:linear-gradient(90deg,#000 82%,rgba(0,0,0,.15) 100%)
    }
  }
  .cmp-table{width:100%;border-collapse:separate;border-spacing:0;font-size:12px;min-width:640px}
  .cmp-table th{
    background:#f4effc;color:#9a90ae;font-weight:800;font-size:11px;padding:8px 5px;
    border-bottom:1px solid var(--line);white-space:nowrap;position:sticky;top:0
  }
  .cmp-table td{padding:8px 5px;text-align:center;border-bottom:1px dashed #eee7f8;color:#635a7c;font-weight:600;white-space:nowrap}
  .cmp-table td.month{font-weight:800;color:var(--pink-deep)}
  .cmp-table tbody tr{cursor:pointer}
  .cmp-table tbody tr:hover td{background:#f7f3ff}
  .cmp-table tbody tr.on td{background:#f0eafd}
  .cmp-table td.dim{color:#c3bad2}

  /* ============ 돌아보기 ============ */
  .rev-grid{display:grid;gap:10px}
  @media(min-width:760px){.rev-grid{grid-template-columns:1fr 1fr}.rev-grid .full{grid-column:1 / -1}}
  .rev-grid label{display:flex;flex-direction:column;gap:5px;font-size:11.5px;font-weight:800;color:#7c7391}
  .rev-grid textarea{
    border:1px solid #e8dff6;border-radius:13px;padding:9px 11px;background:#fffefe;resize:vertical;
    min-height:62px;font-size:13px;line-height:1.55;outline:0;color:var(--ink)
  }
  .rev-grid textarea:focus{border-color:#b9a4e8;box-shadow:0 0 0 3px #eae2fb}
  .stars{display:flex;align-items:center;gap:10px;margin-top:12px;flex-wrap:wrap}
  .stars .lb{font-size:12px;font-weight:800;color:#7c7391}
  .star-btns{display:flex;gap:2px}
  .star{font-size:21px;line-height:1;color:#e2dcf0;transition:transform .1s,color .15s;padding:0 1px}
  .star.on{color:#f7b63f}
  .star:active{transform:scale(1.15)}
  .star-note{font-size:11px;font-weight:700;color:var(--muted)}

  /* ============ 설정 모달 ============ */
  .modal{position:fixed;inset:0;z-index:50;display:grid;place-items:center;padding:16px;background:rgba(58,50,88,.28);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
  .modal[hidden]{display:none}
  .modal-card{
    width:100%;max-width:520px;max-height:88vh;overflow:auto;background:var(--card);
    border-radius:24px;border:1px solid var(--line);box-shadow:0 24px 60px rgba(74,62,104,.22);padding:16px 16px 20px
  }
  .modal-card.narrow{max-width:360px}
  .modal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
  .modal-head h2{font-size:16px;font-weight:800}
  .modal-card h3{font-size:12.5px;font-weight:800;color:#7c7391;margin:0 0 8px}
  .modal-card hr{border:0;border-top:1px dashed #e9e1f5;margin:16px 0}
  .lbl{display:block;font-size:11px;font-weight:800;color:var(--muted);margin-bottom:5px}
  .text-input{
    width:100%;border:1px solid #e6ddf5;border-radius:12px;padding:9px 11px;background:#fffefe;
    font-size:13px;outline:0
  }
  .text-input:focus{border-color:#b9a4e8;box-shadow:0 0 0 3px #eae2fb}
  .btn-row{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}
  .btn-row.end{justify-content:flex-end;margin-top:14px}
  .btn{
    flex:1;min-width:120px;border:1px solid #e4daf6;background:#fffefe;border-radius:12px;
    padding:9px 10px;font-size:12.5px;font-weight:800;color:#7c7391;transition:transform .1s,background .15s
  }
  .btn:active{transform:scale(.98)}
  .btn.primary{background:linear-gradient(135deg,#e9e0fc,#f3edfe);border-color:var(--line-strong);color:var(--pink-deep)}
  .btn.danger{background:#fff6f3;border-color:#f7d8cb;color:#c9603f}
  .btn[disabled]{opacity:.55;cursor:default}
  .check{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;color:#7c7391;margin-top:10px}
  .check input{width:15px;height:15px;accent-color:#8b74d4}
  .status{
    margin-top:9px;font-size:11.5px;font-weight:700;color:var(--muted);background:#f7f4fc;
    border:1px solid var(--line);border-radius:11px;padding:8px 10px;line-height:1.5;word-break:break-all
  }
  .status.ok{color:#3f8663;background:#f5fdf8;border-color:#d4ecdd}
  .status.error{color:#bf5a3a;background:#fff8f4;border-color:#f6d9cd}
  .name-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .name-row label{display:flex;align-items:center;gap:6px;font-size:14px}
  .code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:10.5px;background:#f3edfd;border:1px solid var(--line);border-radius:5px;padding:1px 4px}
  .foot{text-align:center;font-size:10.5px;color:#b3a9c6;line-height:1.7;margin-top:6px}

  /* ============ 토스트 ============ */
  .toast{
    position:fixed;left:50%;bottom:22px;transform:translate(-50%,14px);z-index:60;
    background:rgba(52,44,78,.93);color:#fff;font-size:12.5px;font-weight:700;
    padding:10px 16px;border-radius:99px;box-shadow:0 10px 26px rgba(58,50,88,.28);
    opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:86vw;text-align:center
  }
  .toast.on{opacity:1;transform:translate(-50%,0)}
  .toast[hidden]{display:none}
</style>
</head>
<body>
<div class="wrap">

  <header class="top">
    <div class="brand">
      <h1>💜 학습관리노트</h1>
      <p class="sub">매일 조금씩 쌓이는 나의 시간 · <span id="todayText">—</span></p>
    </div>
    <div class="top-actions">
      <button class="sync-chip" id="syncChip" type="button" title="구글 시트 연결 상태 · 누르면 설정">☁️ 기기에 저장</button>
      <button class="icon-btn" id="openSettings" type="button" aria-label="설정 열기">⚙️</button>
    </div>
  </header>

